{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/game/**",
              "components/navigation/**",
              "ui_kits/turbo-math-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lilita One|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Lilita One, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|state|shape|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<AnswerTile> doesn't accept that prop. Declared props: children, state, shape, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerTile'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|correct|wrong)$/]",
        "message": "<AnswerTile> state must be one of 'default' | 'correct' | 'wrong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerTile'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|pill)$/]",
        "message": "<AnswerTile> shape must be one of 'circle' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|primary|accent|reward|success)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'primary' | 'accent' | 'reward' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ghost|reward)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'ghost' | 'reward'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|neutral|success)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'accent' | 'neutral' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|stars|locked|variant|onClick|key|ref|className|style|children)$/]",
        "message": "<LevelTile> doesn't accept that prop. Declared props: icon, label, stars, locked, variant, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<LevelTile> variant must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|badge|variant|onClick|key|ref|className|style|children)$/]",
        "message": "<MenuCard> doesn't accept that prop. Declared props: icon, title, description, badge, variant, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|accent|reward)$/]",
        "message": "<MenuCard> variant must be one of 'default' | 'accent' | 'reward'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|icon|title|subtitle|children|onClose|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, icon, title, subtitle, children, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|variant|height|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, variant, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|reward|success)$/]",
        "message": "<ProgressBar> variant must be one of 'primary' | 'reward' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|key|ref|className|style|children)$/]",
        "message": "<QuickNavItem> doesn't accept that prop. Declared props: id, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizStatRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:correct|wrong|accuracy|key|ref|className|style|children)$/]",
        "message": "<QuizStatRow> doesn't accept that prop. Declared props: correct, wrong, accuracy."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|stars|actions|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, stars, actions."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
